// ─────────────────────────────────────────────────────────────────────────
// HMS — Prisma schema (Phase 1: core, auth, RBAC, organisation)
// UUID PKs · timestamps · soft delete · audit columns · optimistic locking
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum DepartmentType {
  CLINICAL
  DIAGNOSTIC
  SUPPORT
  ADMINISTRATIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum MedicalConditionStatus {
  ACTIVE
  RESOLVED
  CHRONIC
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  SCHEDULED
  WALK_IN
}

enum SpecimenType {
  BLOOD
  URINE
  STOOL
  SWAB
  TISSUE
  OTHER
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LabResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  OINTMENT
  DROPS
  OTHER
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  INSURANCE
  BANK_TRANSFER
}

enum PaymentType {
  PAYMENT
  REFUND
}

enum RadiologyModality {
  XRAY
  MRI
  CT
  ULTRASOUND
  MAMMOGRAPHY
  OTHER
}

enum RadiologyStatus {
  REQUESTED
  SCHEDULED
  PERFORMED
  REPORTED
  CANCELLED
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SETTLED
}

// ── Identity & Access ────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  status       UserStatus @default(ACTIVE)

  // Optional organisational scoping
  hospitalId String? @db.Uuid
  branchId   String? @db.Uuid
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Security / lifecycle
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // RBAC
  userRoles UserRole[]

  // Optional patient portal account link (one-to-one)
  patient Patient? @relation("PatientAccount")

  // Scheduling (as the doctor)
  doctorAppointments   Appointment[]        @relation("DoctorAppointments")
  doctorAvailabilities DoctorAvailability[]

  // Lab (as the ordering physician)
  orderedLabOrders LabOrder[] @relation("OrderedLabOrders")

  // Security trails
  refreshTokens  RefreshToken[]
  loginHistories LoginHistory[]
  auditLogs      AuditLog[]     @relation("AuditActor")

  // Audit columns + optimistic lock + soft delete
  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([hospitalId])
  @@index([branchId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique // e.g. SUPER_ADMIN
  displayName String
  description String?
  isSystem    Boolean @default(false)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  action      String  @unique // e.g. patient.create
  resource    String // e.g. patient
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedBy String?  @db.Uuid
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ── Security trails ──────────────────────────────────────────────────────

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique // sha256 of the opaque token
  family    String   @db.Uuid // rotation family for reuse detection
  expiresAt DateTime
  revokedAt DateTime?
  replacedByTokenId String? @db.Uuid

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email     String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_histories")
}

model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  actorId  String? @db.Uuid
  actor    User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String // e.g. user.update
  entityType String // e.g. User
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Organisation ─────────────────────────────────────────────────────────

model Hospital {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  code          String  @unique
  licenseNumber String?
  email         String?
  phone         String?
  addressLine   String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  isActive      Boolean @default(true)

  branches             Branch[]
  departments          Department[]
  users                User[]
  patients             Patient[]
  appointments         Appointment[]
  doctorAvailabilities DoctorAvailability[]
  labOrders            LabOrder[]
  labTests             LabTest[]
  medicines            Medicine[]
  pharmacySales        PharmacySale[]
  invoices             Invoice[]
  radiologyExams       RadiologyExam[]
  radiologyStudies     RadiologyStudy[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("hospitals")
}

model Branch {
  id         String @id @default(uuid()) @db.Uuid
  hospitalId String @db.Uuid
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  name        String
  code        String
  email       String?
  phone       String?
  addressLine String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  isActive    Boolean @default(true)

  departments          Department[]
  users                User[]
  patients             Patient[]
  appointments         Appointment[]
  doctorAvailabilities DoctorAvailability[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([deletedAt])
  @@map("branches")
}

model Department {
  id         String  @db.Uuid @id @default(uuid())
  hospitalId String  @db.Uuid
  branchId   String? @db.Uuid
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name        String
  code        String
  type        DepartmentType @default(CLINICAL)
  description String?
  isActive    Boolean @default(true)

  appointments         Appointment[]
  doctorAvailabilities DoctorAvailability[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("departments")
}

// ── Clinical: patients & profile ─────────────────────────────────────────

model Patient {
  id            String @id @default(uuid()) @db.Uuid
  patientNumber Int    @unique @default(autoincrement()) // drives the human-readable MRN

  firstName     String
  lastName      String
  middleName    String?
  dateOfBirth   DateTime       @db.Date
  gender        Gender
  bloodGroup    BloodGroup?
  maritalStatus MaritalStatus?

  email      String?
  phone      String
  nationalId String?

  addressLine String?
  city        String?
  state       String?
  country     String?
  postalCode  String?

  status PatientStatus @default(ACTIVE)

  // Optional organisational scoping + portal account
  hospitalId String?   @db.Uuid
  branchId   String?   @db.Uuid
  userId     String?   @unique @db.Uuid
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user       User?     @relation("PatientAccount", fields: [userId], references: [id], onDelete: SetNull)

  emergencyContacts EmergencyContact[]
  allergies         Allergy[]
  medicalHistories  MedicalHistory[]
  appointments      Appointment[]
  labOrders         LabOrder[]
  pharmacySales     PharmacySale[]
  invoices          Invoice[]
  radiologyStudies  RadiologyStudy[]
  insuranceClaims   InsuranceClaim[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([lastName])
  @@index([phone])
  @@index([hospitalId])
  @@index([status])
  @@index([deletedAt])
  @@map("patients")
}

model EmergencyContact {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  name         String
  relationship String
  phone        String
  email        String?
  addressLine  String?
  isPrimary    Boolean @default(false)

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId])
  @@index([deletedAt])
  @@map("emergency_contacts")
}

model Allergy {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  allergen String
  reaction String?
  severity AllergySeverity @default(MILD)
  notes    String?

  recordedBy String?   @db.Uuid
  version    Int       @default(1)
  createdBy  String?   @db.Uuid
  updatedBy  String?   @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([patientId])
  @@index([deletedAt])
  @@map("allergies")
}

model MedicalHistory {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  condition   String
  notes       String?
  diagnosedAt DateTime?               @db.Date
  status      MedicalConditionStatus @default(ACTIVE)

  recordedBy String?   @db.Uuid
  version    Int       @default(1)
  createdBy  String?   @db.Uuid
  updatedBy  String?   @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([patientId])
  @@index([deletedAt])
  @@map("medical_histories")
}

// ── Scheduling: doctor availability & appointments ───────────────────────

model DoctorAvailability {
  id       String @id @default(uuid()) @db.Uuid
  doctorId String @db.Uuid
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  hospitalId   String  @db.Uuid
  branchId     String? @db.Uuid
  departmentId String? @db.Uuid
  hospital     Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  dayOfWeek           Int // 0 = Sunday … 6 = Saturday
  startTime           String // "HH:MM" 24h
  endTime             String // "HH:MM" 24h
  slotDurationMinutes Int     @default(15)
  isActive            Boolean @default(true)

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([doctorId, dayOfWeek])
  @@index([hospitalId])
  @@index([deletedAt])
  @@map("doctor_availabilities")
}

model Appointment {
  id                String @id @default(uuid()) @db.Uuid
  appointmentNumber Int    @unique @default(autoincrement())

  patientId String  @db.Uuid
  doctorId  String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    User    @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)

  hospitalId   String  @db.Uuid
  branchId     String? @db.Uuid
  departmentId String? @db.Uuid
  hospital     Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  scheduledStart DateTime
  scheduledEnd   DateTime
  status         AppointmentStatus @default(BOOKED)
  type           AppointmentType   @default(SCHEDULED)
  reason         String?
  notes          String?

  // Queue / token (assigned on check-in or walk-in)
  tokenDate   DateTime? @db.Date
  tokenNumber Int?
  checkedInAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  cancelledAt        DateTime?
  cancellationReason String?

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([doctorId, tokenDate, tokenNumber])
  @@index([doctorId, scheduledStart])
  @@index([patientId])
  @@index([status])
  @@index([tokenDate])
  @@index([deletedAt])
  @@map("appointments")
}

// ── Laboratory ───────────────────────────────────────────────────────────

model LabTest {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  name         String
  category     String?
  specimenType SpecimenType @default(BLOOD)
  unit         String?
  referenceRange String?
  price        Decimal      @default(0) @db.Decimal(10, 2)
  isActive     Boolean      @default(true)

  hospitalId String?   @db.Uuid
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  orderItems LabOrderItem[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([deletedAt])
  @@map("lab_tests")
}

model LabOrder {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber Int    @unique @default(autoincrement())

  patientId   String  @db.Uuid
  hospitalId  String  @db.Uuid
  orderedById String? @db.Uuid
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  orderedBy   User?    @relation("OrderedLabOrders", fields: [orderedById], references: [id], onDelete: SetNull)

  status            LabOrderStatus @default(ORDERED)
  notes             String?
  sampleCollectedAt DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancellationReason String?

  items LabOrderItem[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId])
  @@index([status])
  @@index([deletedAt])
  @@map("lab_orders")
}

model LabOrderItem {
  id      String   @id @default(uuid()) @db.Uuid
  orderId String   @db.Uuid
  testId  String   @db.Uuid
  order   LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test    LabTest  @relation(fields: [testId], references: [id], onDelete: Restrict)

  resultValue String?
  unit        String?
  flag        LabResultFlag?
  resultNotes String?
  resultedAt  DateTime?
  resultedById String? @db.Uuid

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, testId])
  @@index([testId])
  @@map("lab_order_items")
}

// ── Pharmacy & Inventory ─────────────────────────────────────────────────

model Medicine {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  name         String
  genericName  String?
  form         MedicineForm @default(TABLET)
  strength     String?
  manufacturer String?
  unitPrice    Decimal      @default(0) @db.Decimal(10, 2)
  reorderLevel Int          @default(0)
  isActive     Boolean      @default(true)

  hospitalId String?   @db.Uuid
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  batches   MedicineBatch[]
  saleItems PharmacySaleItem[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([deletedAt])
  @@map("medicines")
}

model MedicineBatch {
  id         String   @id @default(uuid()) @db.Uuid
  medicineId String   @db.Uuid
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  batchNumber String
  quantity    Int
  expiryDate  DateTime @db.Date
  costPrice   Decimal? @db.Decimal(10, 2)

  saleItems PharmacySaleItem[]

  createdBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([medicineId, expiryDate])
  @@index([deletedAt])
  @@map("medicine_batches")
}

model PharmacySale {
  id         String @id @default(uuid()) @db.Uuid
  saleNumber Int    @unique @default(autoincrement())

  patientId  String?  @db.Uuid
  hospitalId String?  @db.Uuid
  patient    Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  soldById   String?  @db.Uuid

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  items PharmacySaleItem[]

  createdBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId])
  @@index([createdAt])
  @@map("pharmacy_sales")
}

model PharmacySaleItem {
  id     String       @id @default(uuid()) @db.Uuid
  saleId String       @db.Uuid
  sale   PharmacySale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  medicineId String   @db.Uuid
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batchId    String?  @db.Uuid
  batch      MedicineBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([medicineId])
  @@map("pharmacy_sale_items")
}

// ── Billing ──────────────────────────────────────────────────────────────

model Invoice {
  id            String @id @default(uuid()) @db.Uuid
  invoiceNumber Int    @unique @default(autoincrement())

  patientId  String   @db.Uuid
  hospitalId String?  @db.Uuid
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  status     InvoiceStatus @default(ISSUED)
  subtotal   Decimal       @default(0) @db.Decimal(12, 2)
  discount   Decimal       @default(0) @db.Decimal(12, 2)
  tax        Decimal       @default(0) @db.Decimal(12, 2)
  total      Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid Decimal       @default(0) @db.Decimal(12, 2)
  notes      String?

  cancelledAt        DateTime?
  cancellationReason String?

  items    InvoiceItem[]
  payments Payment[]
  claims   InsuranceClaim[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId])
  @@index([status])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(CASH)
  type         PaymentType   @default(PAYMENT)
  reference    String?
  note         String?
  receivedById String?       @db.Uuid

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("payments")
}

// ── Radiology ────────────────────────────────────────────────────────────

model RadiologyExam {
  id       String            @id @default(uuid()) @db.Uuid
  code     String            @unique
  name     String
  modality RadiologyModality @default(XRAY)
  bodyPart String?
  price    Decimal           @default(0) @db.Decimal(10, 2)
  isActive Boolean           @default(true)

  hospitalId String?   @db.Uuid
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  studies RadiologyStudy[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([modality])
  @@index([deletedAt])
  @@map("radiology_exams")
}

model RadiologyStudy {
  id          String @id @default(uuid()) @db.Uuid
  studyNumber Int    @unique @default(autoincrement())

  patientId  String  @db.Uuid
  hospitalId String  @db.Uuid
  examId     String  @db.Uuid
  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital   Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  exam       RadiologyExam @relation(fields: [examId], references: [id], onDelete: Restrict)

  referredById   String? @db.Uuid
  radiologistId  String? @db.Uuid

  status      RadiologyStatus @default(REQUESTED)
  scheduledAt DateTime?
  performedAt DateTime?
  reportedAt  DateTime?

  findings   String?
  impression String?
  imageUrl   String?

  cancelledAt        DateTime?
  cancellationReason String?

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId])
  @@index([status])
  @@index([deletedAt])
  @@map("radiology_studies")
}

// ── Insurance ────────────────────────────────────────────────────────────

model InsuranceProvider {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique
  name         String
  contactEmail String?
  contactPhone String?
  isActive     Boolean @default(true)

  claims InsuranceClaim[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("insurance_providers")
}

model InsuranceClaim {
  id          String @id @default(uuid()) @db.Uuid
  claimNumber Int    @unique @default(autoincrement())

  patientId  String  @db.Uuid
  providerId String  @db.Uuid
  invoiceId  String? @db.Uuid
  patient    Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider   InsuranceProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  invoice    Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  policyNumber   String
  claimedAmount  Decimal      @db.Decimal(12, 2)
  approvedAmount Decimal?     @db.Decimal(12, 2)
  status         ClaimStatus  @default(SUBMITTED)
  notes          String?
  decisionNote   String?

  submittedAt DateTime  @default(now())
  decisionAt  DateTime?
  settledAt   DateTime?

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId])
  @@index([providerId])
  @@index([status])
  @@index([deletedAt])
  @@map("insurance_claims")
}
