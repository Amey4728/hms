// ─────────────────────────────────────────────────────────────────────────
// HMS — Prisma schema (Phase 1: core, auth, RBAC, organisation)
// UUID PKs · timestamps · soft delete · audit columns · optimistic locking
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum DepartmentType {
  CLINICAL
  DIAGNOSTIC
  SUPPORT
  ADMINISTRATIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum MedicalConditionStatus {
  ACTIVE
  RESOLVED
  CHRONIC
}

// ── Identity & Access ────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  status       UserStatus @default(ACTIVE)

  // Optional organisational scoping
  hospitalId String? @db.Uuid
  branchId   String? @db.Uuid
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Security / lifecycle
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // RBAC
  userRoles UserRole[]

  // Optional patient portal account link (one-to-one)
  patient Patient? @relation("PatientAccount")

  // Security trails
  refreshTokens  RefreshToken[]
  loginHistories LoginHistory[]
  auditLogs      AuditLog[]     @relation("AuditActor")

  // Audit columns + optimistic lock + soft delete
  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([hospitalId])
  @@index([branchId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique // e.g. SUPER_ADMIN
  displayName String
  description String?
  isSystem    Boolean @default(false)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  action      String  @unique // e.g. patient.create
  resource    String // e.g. patient
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedBy String?  @db.Uuid
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ── Security trails ──────────────────────────────────────────────────────

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique // sha256 of the opaque token
  family    String   @db.Uuid // rotation family for reuse detection
  expiresAt DateTime
  revokedAt DateTime?
  replacedByTokenId String? @db.Uuid

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email     String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_histories")
}

model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  actorId  String? @db.Uuid
  actor    User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String // e.g. user.update
  entityType String // e.g. User
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Organisation ─────────────────────────────────────────────────────────

model Hospital {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  code          String  @unique
  licenseNumber String?
  email         String?
  phone         String?
  addressLine   String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  isActive      Boolean @default(true)

  branches    Branch[]
  departments Department[]
  users       User[]
  patients    Patient[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("hospitals")
}

model Branch {
  id         String @id @default(uuid()) @db.Uuid
  hospitalId String @db.Uuid
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  name        String
  code        String
  email       String?
  phone       String?
  addressLine String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  isActive    Boolean @default(true)

  departments Department[]
  users       User[]
  patients    Patient[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([deletedAt])
  @@map("branches")
}

model Department {
  id         String  @db.Uuid @id @default(uuid())
  hospitalId String  @db.Uuid
  branchId   String? @db.Uuid
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name        String
  code        String
  type        DepartmentType @default(CLINICAL)
  description String?
  isActive    Boolean @default(true)

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("departments")
}

// ── Clinical: patients & profile ─────────────────────────────────────────

model Patient {
  id            String @id @default(uuid()) @db.Uuid
  patientNumber Int    @unique @default(autoincrement()) // drives the human-readable MRN

  firstName     String
  lastName      String
  middleName    String?
  dateOfBirth   DateTime       @db.Date
  gender        Gender
  bloodGroup    BloodGroup?
  maritalStatus MaritalStatus?

  email      String?
  phone      String
  nationalId String?

  addressLine String?
  city        String?
  state       String?
  country     String?
  postalCode  String?

  status PatientStatus @default(ACTIVE)

  // Optional organisational scoping + portal account
  hospitalId String?   @db.Uuid
  branchId   String?   @db.Uuid
  userId     String?   @unique @db.Uuid
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user       User?     @relation("PatientAccount", fields: [userId], references: [id], onDelete: SetNull)

  emergencyContacts EmergencyContact[]
  allergies         Allergy[]
  medicalHistories  MedicalHistory[]

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([lastName])
  @@index([phone])
  @@index([hospitalId])
  @@index([status])
  @@index([deletedAt])
  @@map("patients")
}

model EmergencyContact {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  name         String
  relationship String
  phone        String
  email        String?
  addressLine  String?
  isPrimary    Boolean @default(false)

  version   Int       @default(1)
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId])
  @@index([deletedAt])
  @@map("emergency_contacts")
}

model Allergy {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  allergen String
  reaction String?
  severity AllergySeverity @default(MILD)
  notes    String?

  recordedBy String?   @db.Uuid
  version    Int       @default(1)
  createdBy  String?   @db.Uuid
  updatedBy  String?   @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([patientId])
  @@index([deletedAt])
  @@map("allergies")
}

model MedicalHistory {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  condition   String
  notes       String?
  diagnosedAt DateTime?               @db.Date
  status      MedicalConditionStatus @default(ACTIVE)

  recordedBy String?   @db.Uuid
  version    Int       @default(1)
  createdBy  String?   @db.Uuid
  updatedBy  String?   @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([patientId])
  @@index([deletedAt])
  @@map("medical_histories")
}
