# Copy to .env.docker and fill in strong secrets before `docker compose up`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=hms

# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_00000
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_000
COOKIE_SECRET=change_me_cookie_secret_min_32_chars_long_00000

# Set true when serving over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080
