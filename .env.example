# ─────────────────────────────────────────────────────────────
# HMS API — environment configuration (copy to apps/api/.env)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=v1

# PostgreSQL (local install — set your postgres password)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms?schema=public"

# JWT — generate strong secrets, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_0000
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_000
JWT_REFRESH_TTL_DAYS=7

# Cookies
COOKIE_SECRET=change_me_cookie_secret_min_32_chars_long_0000
REFRESH_COOKIE_NAME=hms_rt
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Security
CORS_ORIGINS=http://localhost:5173
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# Bootstrap super admin (used by the seed script)
SEED_SUPERADMIN_EMAIL=superadmin@hms.local
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
